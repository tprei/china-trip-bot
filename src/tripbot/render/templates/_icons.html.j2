{% macro icon(name, color="#eef2f5", size=30) -%}
{%- if name == "plane" -%}
<svg viewBox="0 0 24 24" aria-hidden="true" width="{{ size }}" height="{{ size }}" fill="{{ color }}"><g transform="rotate(90 12 12)"><path d="M12 2.5c.9 0 1.6.8 1.6 1.7v5.3l7.4 4.3v2.1l-7.4-2.3v4.6l2.3 1.7v1.6L12 20.4l-3.9 1.1v-1.6l2.3-1.7v-4.6L3 15.9v-2.1l7.4-4.3V4.2c0-.9.7-1.7 1.6-1.7z"/></g></svg>
{%- elif name == "train" -%}
<svg viewBox="0 0 24 24" aria-hidden="true" width="{{ size }}" height="{{ size }}" fill="none" stroke="{{ color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 10h14M8.5 17l-2 4M15.5 17l2 4"/><circle cx="9" cy="13.5" r="0.6" fill="{{ color }}"/><circle cx="15" cy="13.5" r="0.6" fill="{{ color }}"/></svg>
{%- elif name == "sleeper" -%}
<svg viewBox="0 0 24 24" aria-hidden="true" width="{{ size }}" height="{{ size }}" fill="none" stroke="{{ color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7z"/></svg>
{%- elif name == "calendar" -%}
<svg viewBox="0 0 24 24" aria-hidden="true" width="{{ size }}" height="{{ size }}" fill="none" stroke="{{ color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
{%- elif name == "pin" -%}
<svg viewBox="0 0 24 24" aria-hidden="true" width="{{ size }}" height="{{ size }}" fill="none" stroke="{{ color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
{%- elif name == "check" -%}
<svg viewBox="0 0 24 24" role="img" aria-label="{{ _("ok") }}" width="{{ size }}" height="{{ size }}" fill="none" stroke="{{ color }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 9.5"/></svg>
{%- elif name == "warning" -%}
<svg viewBox="0 0 24 24" role="img" aria-label="{{ _("warning") }}" width="{{ size }}" height="{{ size }}" fill="none" stroke="{{ color }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l10 18H2z"/><path d="M12 10v5M12 18h.01"/></svg>
{%- elif name == "down" -%}
<svg viewBox="0 0 24 24" aria-hidden="true" width="{{ size }}" height="{{ size }}" fill="{{ color }}"><path d="M4 7h16l-8 11z"/></svg>
{%- elif name == "up" -%}
<svg viewBox="0 0 24 24" aria-hidden="true" width="{{ size }}" height="{{ size }}" fill="{{ color }}"><path d="M4 17h16l-8-11z"/></svg>
{%- endif -%}
{%- endmacro %}

{% macro flag(code, width=39, height=26) -%}
{%- if code == "gb" -%}
<svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true" width="{{ width }}" height="{{ height }}" style="border-radius:4px;overflow:hidden;flex-shrink:0"><rect width="60" height="30" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="2"/><path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/><path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/></svg>
{%- elif code == "br" -%}
<svg viewBox="0 0 36 24" aria-hidden="true" width="{{ width }}" height="{{ height }}" style="border-radius:4px;overflow:hidden;flex-shrink:0"><rect width="36" height="24" fill="#009B3A"/><polygon points="18,3 33,12 18,21 3,12" fill="#FEDF00"/><circle cx="18" cy="12" r="5.2" fill="#002776"/><path d="M13 11 Q18 9.6 23 12.4" fill="none" stroke="#fff" stroke-width="1"/></svg>
{%- elif code == "mx" -%}
<svg viewBox="0 0 36 24" aria-hidden="true" width="{{ width }}" height="{{ height }}" style="border-radius:4px;overflow:hidden;flex-shrink:0"><rect width="12" height="24" fill="#006847"/><rect x="12" width="12" height="24" fill="#fff"/><rect x="24" width="12" height="24" fill="#CE1126"/><circle cx="18" cy="12" r="3" fill="#8C5A2B"/></svg>
{%- elif code == "eu" -%}
<svg viewBox="0 0 36 24" aria-hidden="true" width="{{ width }}" height="{{ height }}" style="border-radius:4px;overflow:hidden;flex-shrink:0"><rect width="36" height="24" fill="#1F3F99"/><g fill="#FFCC00">{% for x, y in [(25,12),(24.1,15.5),(21.5,18.1),(18,19),(14.5,18.1),(11.9,15.5),(11,12),(11.9,8.5),(14.5,5.9),(18,5),(21.5,5.9),(24.1,8.5)] %}<circle cx="{{ x }}" cy="{{ y }}" r="1.1"/>{% endfor %}</g></svg>
{%- endif -%}
{%- endmacro %}

{% macro airline(code, logo_url) -%}
<span class="airline">{{ code }}{% if logo_url %}<img src="{{ logo_url }}" alt="" onerror="this.remove()">{% endif %}</span>
{%- endmacro %}

