{% extends "_base.html.j2" %}

{% block card %}
<div class="card" style="padding:56px 64px 56px;gap:28px">
  <div><div class="kicker">{{ view.kicker|upper }}</div><div class="title">{{ view.title }}</div></div>
  {% for row in view.rows %}
  <div class="panel" style="display:flex;flex-direction:column;gap:14px;{{ 'border:3px solid #ff6a4d;background:#2a1a18' if row.highlight }}">
    <div class="row" style="gap:20px">
      <div style="display:flex;flex-direction:column;gap:4px">
        <span style="font-size:32px;font-weight:800">{{ row.label }}</span>
        <span style="font-size:22px;color:var(--muted)">{{ row.sub }}</span>
      </div>
      <div class="spacer"></div>
      {% if row.delta %}<span class="delta {{ 'good' if row.delta_good else 'bad' }}" style="font-size:28px">{{ '▼' if row.delta_good else '▲' }} {{ row.delta }}</span>{% endif %}
      <span class="num" style="font-size:64px">{{ row.total }}</span>
    </div>
    <div style="height:10px;background:var(--line);border-radius:5px;overflow:hidden"><div style="width:{{ row.width }}%;height:10px;background:{{ '#ff6a4d' if row.highlight else '#8fb3d9' }};border-radius:5px"></div></div>
  </div>
  {% endfor %}
</div>
{% endblock %}
