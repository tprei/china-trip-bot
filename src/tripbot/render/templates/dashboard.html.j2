{% from "_icons.html.j2" import icon, flag, airline %}
{% set colors = {"A": "#8fb3d9", "B": "#ff6a4d", "C": "#b7c4d1"} %}
{% macro flight(item) -%}
<div class="flight">
  {{ airline(item.line.airline_code, item.line.logo_url) }}
  <div class="path">
    <span class="code">{{ item.line.origin }}<small>{{ item.line.origin_city }}</small></span>
    <span class="arrow">→</span>
    <span class="code">{{ item.line.destination }}<small>{{ item.line.destination_city }}</small></span>
  </div>
  <div class="meta"><span>{{ item.line.day }}</span><span>{{ item.line.duration }} · {{ item.line.note }}</span></div>
  {% if item.price %}<b class="price">{{ item.price }}</b>{% endif %}
</div>
{%- endmacro %}
{% macro compare(view) -%}
<div class="list">
  {% for row in view.rows %}
  <div class="item{{ ' hl' if row.highlight }}">
    <div class="grow"><b>{{ row.label }}</b><small>{{ row.sub }}</small></div>
    {% if row.delta %}<span class="delta {{ 'good' if row.delta_good else 'bad' }}">{{ '▼' if row.delta_good else '▲' }} {{ row.delta }}</span>{% endif %}
    <b class="num">{{ row.total }}</b>
  </div>
  {% endfor %}
</div>
{%- endmacro %}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>{{ _("China trip") }}</title>
<style>
@font-face { font-family: "Archivo"; src: url("{{ fonts.archivo }}") format("woff2"); font-weight: 100 900; font-stretch: 62% 125%; }
@font-face { font-family: "JetBrains Mono"; src: url("{{ fonts.mono_400 }}") format("woff2"); font-weight: 400; }
@font-face { font-family: "JetBrains Mono"; src: url("{{ fonts.mono_700 }}") format("woff2"); font-weight: 700; }
:root {
  --bg: #0e1620; --surface: #16212d; --surface-2: #1e2b3a; --line: #2a3a4c; --text: #eef2f5;
  --muted: #9fb0c2; --accent: #ff6a4d; --accent-soft: #ff8a73; --hl: #2a1a18;
  --good: #6fe0b5; --warn: #f5b83d; --bad: #ffb3a3;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.35 "Archivo", system-ui, sans-serif; }
main { max-width: 760px; margin: 0 auto; padding: 20px 16px 48px; }
h1 { font-size: 28px; font-weight: 800; font-stretch: 85%; margin: 0; }
h2 { font: 700 13px "JetBrains Mono", monospace; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 28px 0 10px; }
small { display: block; font-size: 12px; color: var(--muted); font-weight: 500; }
.mono, .updated, .meta, .code { font-family: "JetBrains Mono", monospace; }
.updated { color: var(--muted); font-size: 13px; }
.num { font-weight: 900; font-stretch: 78%; letter-spacing: -0.01em; }
.tabs { display: flex; gap: 8px; margin: 18px 0 6px; }
.tabs label { flex: 1; text-align: center; padding: 10px 6px; border: 2px solid var(--line); border-radius: 12px; cursor: pointer; }
.tabs label b { display: block; font-size: 18px; }
.tabs label small { white-space: nowrap; }
input[name=window] { position: absolute; opacity: 0; pointer-events: none; }
.panel { display: none; }
{% for panel in (view.panels if joint is not defined else []) %}
#tab-{{ panel.id }}:checked ~ .tabs label[for=tab-{{ panel.id }}] { border-color: var(--accent); background: var(--hl); }
#tab-{{ panel.id }}:checked ~ #panel-{{ panel.id }} { display: block; }
{% endfor %}
.hero { margin-top: 16px; }
.hero .num { font-size: 64px; line-height: 1; }
.currencies { display: flex; flex-wrap: wrap; gap: 14px; color: var(--muted); margin-top: 6px; }
.currencies span { display: inline-flex; align-items: center; gap: 6px; }
.currencies svg { width: 21px; height: 14px; }
.box { background: var(--surface); border-radius: 14px; padding: 14px; margin-bottom: 10px; }
.box > header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
.box > header b { font-size: 18px; }
.flight { display: grid; grid-template-columns: 34px 1fr auto; gap: 4px 10px; align-items: center; padding: 8px 0; border-top: 1px solid var(--line); }
.flight:first-of-type { border-top: 0; }
.airline { position: relative; width: 34px; height: 24px; border-radius: 6px; background: var(--text); color: var(--bg); font: 700 12px "JetBrains Mono", monospace; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; }
.airline img { position: absolute; inset: 1px; width: 32px; height: 22px; object-fit: contain; background: #fff; }
.flight .path { display: flex; align-items: flex-start; gap: 8px; }
.flight .code { font-weight: 700; font-size: 17px; }
.flight .arrow { color: var(--muted); }
.flight .meta { grid-column: 2 / 4; display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
.flight .price { grid-row: 1; grid-column: 3; font-size: 17px; }
.label { font: 700 11px "JetBrains Mono", monospace; letter-spacing: 0.12em; color: var(--muted); margin: 10px 0 2px; }
.list { display: flex; flex-direction: column; gap: 6px; }
.item { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 2px solid transparent; border-radius: 12px; padding: 10px 12px; }
.item.hl { border-color: var(--accent); background: var(--hl); }
.item .grow { flex: 1; min-width: 0; }
.item .num { font-size: 22px; }
.tag { display: block; font: 700 11px "JetBrains Mono", monospace; color: var(--warn); }
.delta { font-size: 13px; font-weight: 700; white-space: nowrap; }
.delta.good { color: var(--good); }
.delta.bad { color: var(--bad); }
.step { display: grid; grid-template-columns: 92px 26px 1fr; gap: 8px; align-items: center; padding: 8px 0; border-top: 1px solid var(--line); }
.step:first-child { border-top: 0; }
.step .day { font: 12px "JetBrains Mono", monospace; color: var(--muted); }
.step .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--text); margin: 0 auto; }
.step svg { width: 22px; height: 22px; }
.step.stay b { font-size: 17px; }
.step.sleeper small { color: var(--warn); }
ul, ol { margin: 0; padding-left: 20px; }
li { margin: 4px 0; }
.chart svg { width: 100%; height: auto; }
.legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 13px; margin-top: 6px; }
.status { color: var(--warn); font-weight: 800; }
@media (min-width: 640px) { .groups { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; } .groups .box { margin: 0; } }
</style>
</head>
<body>
<main>
  <h1>China 2027</h1>
  <div class="updated">{% trans when=view.updated, zone=timezone|default("BRT") %}Updated {{ when }} · {{ zone }}{% endtrans %}</div>

  {% if joint is defined %}
  <h2>{{ _("Observed fare demo · not checkout") }}</h2>
  <div class="hero"><div class="num">{{ joint.total }}</div><div class="currencies">{% trans people=joint.groups|sum(attribute='adults'), groups=joint.groups|length %}International round trips · {{ people }} people · {{ groups }} groups{% endtrans %}</div></div>
  <div class="box" style="margin-top:18px"><b>{% trans internal=joint.internal %}Internal transport estimate: {{ internal }}{% endtrans %}</b><small>{{ _("Separate · not a live quote · timetable feasibility unverified") }}</small></div>
  <h2>{{ _("Selected round trips") }}</h2>
  {% for group in joint.groups %}
  <div class="box">
    <header><b>{{ group.name }}</b><b>{{ group.total }} <small>{% trans count=group.adults %}{{ count }} adult · whole round trip{% pluralize %}{{ count }} adults · whole round trip{% endtrans %}</small></b></header>
    <small>{% trans per_person=group.per_person, observed=group.observed %}Displayed per person: {{ per_person }} · observed {{ observed }}{% endtrans %}</small>
    {% for journey in group.journeys %}<div class="flight" style="display:block"><b>{{ journey.label }} · {{ journey.path }} · {{ journey.duration }}</b><small>{{ journey.times }} · {{ _("airport-local") }}</small>{% for line in journey.segments %}<small>{{ line }}</small>{% endfor %}<small>{% trans connections=journey.connections %}Connection: {{ connections }}{% endtrans %}</small></div>{% endfor %}
    {% for warning in group.warnings %}<div style="color:var(--warn)">{{ warning }}</div>{% endfor %}
  </div>
  {% endfor %}
  <h2>{{ _("Scope & limits") }}</h2>
  <div class="box">{{ _("1 sampled combo · no market-best or guaranteed-saving claim") }}<br>{{ _("Trip.com browser fare panels · final checkout / inventory unverified") }}<br>{{ _("Arrival-day hotel / internal connections require review") }}<br>{{ _("No one-way price splitting · no new search · no booking") }}</div>
  {% else %}
  {% for panel in view.panels %}
  <input type="radio" name="window" id="tab-{{ panel.id }}"{{ ' checked' if panel.id == view.selected }}>
  {% endfor %}
  <nav class="tabs">
    {% for panel in view.panels %}
    <label for="tab-{{ panel.id }}"><b>{{ panel.id }}</b><small>{{ panel.dates }}</small><small>{{ panel.total or "—" }}</small></label>
    {% endfor %}
  </nav>

  {% for panel in view.panels %}
  <section class="panel" id="panel-{{ panel.id }}">
    {% if panel.total %}
    <div class="hero">
      <div class="num">{{ panel.total }}</div>
      <div class="currencies">
        {% for money in panel.others %}<span>{{ flag(money.flag) }}{{ money.text }}</span>{% endfor %}
      </div>
    </div>
    {% else %}
    <div class="hero"><b>{{ _("No complete combo yet") }}</b></div>
    {% endif %}

    <h2>{{ _("Flights") }}</h2>
    <div class="groups">
      {% for group in panel.groups %}
      <div class="box">
        <header><b>{{ group.name }}</b>{% if group.chosen %}<span class="mono">{{ group.chosen.price }} <small style="display:inline">{{ group.chosen.price_note }} · {{ group.chosen.fairness_label }}</small></span>{% endif %}</header>
        {% if group.chosen %}
        <div class="label">{{ _("PICK") }}</div>
        {{ flight({"price": "", "line": group.chosen.outbound}) }}
        {{ flight({"price": "", "line": group.chosen.inbound}) }}
        {% endif %}
        <div class="label">{{ _("CHEAPEST OUT") }}</div>
        {% for item in group.outbound %}{{ flight(item) }}{% else %}<small>{{ _("none") }}</small>{% endfor %}
        <div class="label">{{ _("CHEAPEST BACK") }}</div>
        {% for item in group.inbound %}{{ flight(item) }}{% else %}<small>{{ _("none") }}</small>{% endfor %}
      </div>
      {% endfor %}
    </div>

    {% if panel.route %}
    <h2>{% trans internal=panel.route.internal %}Route · {{ internal }} / person inside China{% endtrans %}</h2>
    <div class="box">
      {% for step in panel.route.steps %}
      <div class="step {{ step.kind }} {{ step.mode }}">
        <span class="day">{{ step.day }}</span>
        {% if step.kind == "stay" %}<span class="dot"></span>{% else %}{{ icon("plane" if step.mode == "flight" else step.mode, {"train": "#8fb3d9", "sleeper": "#f5b83d", "flight": "#ff8a73"}[step.mode], 22) }}{% endif %}
        <div><b>{{ step.title }}</b><small>{{ step.detail }}{% if step.estimate %} · {{ _("estimate") }}{% endif %}</small></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <h2>{{ _("Entry × exit") }}</h2>
    <div class="list">
      {% for combo in panel.combos %}
      <div class="item{{ ' hl' if combo.best }}">
        <div class="grow"><b>{{ combo.pair }}</b>{% if not combo.within_rule %}<span class="tag">{{ _("OUT OF RULE") }}</span>{% endif %}</div>
        <b class="num">{{ combo.total }}</b>
      </div>
      {% else %}<small>{{ _("none") }}</small>{% endfor %}
    </div>

    <h2>{{ _("Other plans") }}</h2>
    {{ compare(panel.alternatives) }}

    {% if panel.reminders %}
    <h2>{{ _("Train tickets open") }}</h2>
    <div class="box"><ul>{% for line in panel.reminders %}<li>{{ line }}</li>{% endfor %}</ul></div>
    {% endif %}
  </section>
  {% endfor %}

  <h2>{{ _("Windows") }}</h2>
  {{ compare(view.windows) }}

  {% if view.history %}
  <h2>{{ _("History") }}</h2>
  <div class="box chart">
    <svg viewBox="0 -24 950 404" role="img" aria-label="{{ _("Group total per window over time") }}">
      {% for y, label in view.history.y_labels %}
      <line x1="70" y1="{{ y }}" x2="900" y2="{{ y }}" stroke="#22303f"/>
      <text x="70" y="{{ y - 10 }}" font-family="JetBrains Mono" font-size="26" fill="#9fb0c2">{{ label }}</text>
      {% endfor %}
      {% for x, label in view.history.x_labels %}
      <text x="{{ x }}" y="368" text-anchor="middle" font-family="JetBrains Mono" font-size="24" fill="#9fb0c2">{{ label }}</text>
      {% endfor %}
      {% for line in view.history.lines %}
      <polyline points="{{ line.points }}" fill="none" stroke="{{ colors.get(line.window_id, '#b7c4d1') }}" stroke-width="{{ 6 if line.selected else 4 }}" {% if not line.selected %}stroke-dasharray="12 8"{% endif %} stroke-linejoin="round" stroke-linecap="round"/>
      {% endfor %}
    </svg>
    <div class="legend">
      {% for line in view.history.lines %}<span style="color:{{ colors.get(line.window_id, '#b7c4d1') }}">━ {% trans window=line.window_id, latest=line.latest, low=line.low %}{{ window }} {{ latest }} · low {{ low }}{% endtrans %}</span>{% endfor %}
    </div>
  </div>
  {% endif %}

  <h2>{% trans passport=view.visa.passport %}Visa · {{ passport }} passports{% endtrans %}</h2>
  <div class="box">
    <div class="status">{{ view.visa.status }}</div>
    <small>{{ view.visa_dates }}</small>
    <ol>{% for step in view.visa.steps %}<li>{{ step }}</li>{% endfor %}</ol>
  </div>

  <h2>{{ _("To do") }}</h2>
  <div class="box">
    {% if view.todos %}<ol>{% for text in view.todos %}<li>{{ text }}</li>{% endfor %}</ol>{% else %}<small>{{ _("Nothing left.") }}</small>{% endif %}
  </div>
  {% endif %}
</main>
</body>
</html>
