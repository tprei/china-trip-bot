{% extends "_base.html.j2" %}
{% from "_icons.html.j2" import icon, flag, airline, hills %}

{% macro flight(line) -%}
<div class="leg">
  <div class="flight-meta">
    {{ airline(line.airline_code, line.logo_url) }}
    <span class="flight-day">{{ line.day }}</span>
    <span class="flight-duration">{{ line.duration }} <small>{{ _("total") }}</small></span>
  </div>
  <div class="line">
    <span class="code">
      <b>{{ line.origin }}</b>
      <span class="flight-clock">{{ line.depart_time }}</span>
      <small>{{ line.origin_city }}</small>
    </span>
    <div class="track">
      <div class="rail"></div>
      <div class="end" style="left:0"></div>
      <div class="end" style="right:0"></div>
      {% for stop in line.stops %}
      <div class="flight-stop {{ 'plane-change' if stop.wait else 'same-plane' }}" style="left:{{ (loop.index * 100 / (line.stops|length + 1))|round(1) }}%">
        <span class="stop-marker"></span>
        <b>{{ stop.airport }}</b>
        <span class="stop-detail">{{ stop.detail }}</span>
      </div>
      {% else %}
      <span class="flight-direct">{{ icon("plane", "#eef2f5", 26) }}<span>{{ _("direct") }}</span></span>
      {% endfor %}
    </div>
    <span class="code destination">
      <b>{{ line.destination }}</b>
      <span class="flight-clock">{{ line.arrive_time }}{% if line.arrive_shift %}<sup>{{ line.arrive_shift }}</sup>{% endif %}</span>
      <small>{{ line.destination_city }}</small>
    </span>
  </div>
</div>
{%- endmacro %}

{% block card %}
<div class="card summary-card">
  <header class="header">
    {{ hills() }}
    <div class="top">
      <div><div class="kicker">CHINA 2027</div><div class="title">{{ _("Weekly summary") }}</div></div>
      <div class="dateline">{{ icon("calendar", "#b7c4d1", 30) }}<span>{{ view.date_label }}</span></div>
    </div>
  </header>

  <section class="hero">
    <div class="label">{% trans count=people %}Best plan · {{ count }} person{% pluralize %}Best plan · {{ count }} people{% endtrans %}</div>
    <div class="row" style="align-items:flex-end;gap:28px">
      <div class="num total">{{ view.total }}</div>
      {% if view.delta %}
      <div class="pill {{ 'good' if view.delta_good else 'bad' }}" style="margin-bottom:18px">
        {{ icon("down" if view.delta_good else "up", "#6fe0b5" if view.delta_good else "#ffb3a3", 30) }}<span>{{ view.delta }}</span>
      </div>
      {% endif %}
    </div>
    <div class="person-average">
      <span class="average-label">{{ _("Average per person") }}</span>
      <div class="average-values">
        {% for money in view.per_person %}<span class="item">{{ flag(money.flag, 33, 22) }}<span>{{ money.text }}</span></span>{% endfor %}
      </div>
    </div>
    <div class="chips">
      <div class="chip solid">{{ icon("calendar", "#1a0f0c", 28) }}<span>{{ view.window_dates }}</span><span class="window-length">{{ view.window_days }}</span></div>
      <div class="chip">{{ icon("pin", "#ff8a73", 30) }}<span class="tag">{{ _("IN") }}</span><span class="stack"><span>{{ view.entry_code }}</span><small>{{ view.entry_city }}</small></span></div>
      <div class="chip">{{ icon("pin", "#ff8a73", 30) }}<span class="tag">{{ _("OUT") }}</span><span class="stack"><span>{{ view.exit_code }}</span><small>{{ view.exit_city }}</small></span></div>
    </div>
  </section>

  <section class="section">
    <div class="label">{{ _("Windows") }}</div>
    <div class="windows">
      {% for dot in view.windows %}
      <div class="window {{ 'best' if dot.best }}">
        <span class="id">{{ dot.id }}{% if dot.best %} · {{ _("BEST") }}{% endif %}</span>
        <span class="dates">{{ dot.dates }}</span>
        <span class="num amount">{{ dot.total }}</span>
        {% if dot.delta %}<span class="delta {{ 'good' if dot.delta_good else 'bad' }}">{{ '▼' if dot.delta_good else '▲' }} {{ dot.delta }}</span>{% else %}<span class="delta" style="color:var(--quiet)">{{ _("no change") }}</span>{% endif %}
        {% if dot.rainier %}<span class="rain">{{ icon("warning", "#f5b83d", 20) }} {{ _("rainier") }}</span>{% endif %}
        <div class="scale"><span style="left:{{ dot.position }}%"></span></div>
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="section">
    <div class="row"><div class="label">{{ _("Who flies how") }}</div><div class="spacer"></div><div class="flight-context">{{ _("Times local · vs own best") }}</div></div>
    {% for group in view.groups %}
    <div class="panel ticket">
      <div class="head">
        <div class="avatars">{% for letter in group.initials %}<div class="avatar">{{ letter }}</div>{% endfor %}</div>
        <div class="name">{{ group.name }}</div>
        <div class="spacer"></div>
        <div class="fair"><div class="bar"><span style="width:{{ group.fairness_width }}%"></span></div><span class="pct">{{ group.fairness_label }}</span></div>
        <div class="price"><span class="num">{{ group.price }}</span><small>{{ group.price_note }}</small></div>
      </div>
      <div class="legs {{ 'legs-wide' if group.outbound.stops|length > 1 or group.inbound.stops|length > 1 else '' }}">{{ flight(group.outbound) }}{{ flight(group.inbound) }}</div>
    </div>
    {% endfor %}
  </section>

  <section class="section">
    <div class="label">{{ _("Route") }}</div>
    <div class="panel route-panel">
    <div class="route" style="grid-template-columns:{% for item in view.timeline %}{{ 'auto' if item.kind == 'stop' else 'minmax(0,1fr)' }} {% endfor %}">
      {% for item in view.timeline %}
      {% if item.kind == "stop" %}
      <div class="cell">
        <div class="top"></div>
        <div class="mid"><div class="node {{ 'end' if item.endpoint }}"></div></div>
        <div class="city">{{ item.name }}</div>
      </div>
      {% else %}
      <div class="cell">
        <div class="top">{{ icon("plane" if item.mode == "flight" else item.mode, {"train": "#8fb3d9", "sleeper": "#f5b83d", "flight": "#ff8a73"}[item.mode], 30) }}<span>{{ item.duration }}</span></div>
        <div class="mid"><div class="seg-{{ item.mode }}"></div></div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% if view.days %}
    <div class="day-timeline" role="list" aria-label="{{ _("Nights in China, with arrival and departure dates") }}" style="grid-template-columns:{% for span in view.days %}{{ span.nights }}fr {% endfor %}">
      {% for span in view.days %}
      <div class="day-span {{ span.kind }}" role="listitem" aria-label="{% trans name=span.name, arrive=span.arrive, leave=span.leave, count=span.nights %}{{ name }}: {{ arrive }} to {{ leave }}, {{ count }} night{% pluralize count %}{{ name }}: {{ arrive }} to {{ leave }}, {{ count }} nights{% endtrans %}">
        <div class="day-name">{% if span.kind == "sleeper" %}{{ icon("sleeper", "#f5b83d", 26) }}{% else %}<span>{{ span.name }}</span>{% endif %}</div>
        <div class="day-band"></div>
        <span class="day-date {{ 'first' if loop.first }}" style="--date-row:{{ loop.index0 % 2 }}">{{ span.arrive }}</span>
        {% if loop.last %}<span class="day-date final" style="--date-row:{{ loop.index % 2 }}">{{ span.leave }}</span>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
    </div>
    <div class="legend">
      <span>{{ icon("train", "#8fb3d9", 24) }}{{ _("high-speed") }}</span>
      <span>{{ icon("sleeper", "#f5b83d", 24) }}{{ _("sleeper") }}</span>
      <span>{{ icon("plane", "#ff8a73", 24) }}{{ _("flight") }}</span>
    </div>
  </section>

  <section class="footer">
    <div class="panel">
      <div class="label" style="font-size:22px">{{ _("History") }}</div>
      {% if view.spark %}
      <svg viewBox="0 0 480 160" role="img" aria-label="{{ _("Group total over time") }}" style="width:100%;height:200px">
        <line x1="20" y1="150" x2="460" y2="150" stroke="#2a3a4c"/>
        {% for window_id, points in view.spark.lines %}
        <polyline points="{{ points }}" fill="none" stroke="{{ {'A': '#8fb3d9', 'B': '#ff6a4d', 'C': '#b7c4d1'}.get(window_id, '#b7c4d1') }}" stroke-width="{{ 5 if window_id == selected else 3 }}" {% if window_id != selected %}stroke-dasharray="10 7"{% endif %} stroke-linejoin="round"/>
        {% endfor %}
        <circle cx="{{ view.spark.low_x }}" cy="{{ view.spark.low_y }}" r="8" fill="#0e1620" stroke="#6fe0b5" stroke-width="3"/>
      </svg>
      <div class="keys">
        {% for window_id, points in view.spark.lines %}<span style="color:{{ {'A': '#8fb3d9', 'B': '#ff8a73', 'C': '#b7c4d1'}.get(window_id, '#b7c4d1') }};font-weight:{{ 700 if window_id == selected else 400 }}">━ {{ window_id }}</span>{% endfor %}
        <span style="color:var(--good)">○ {% trans low=view.spark.low_label %}low {{ low }}{% endtrans %}</span>
      </div>
      {% else %}
      <div style="font-size:24px;color:var(--muted)">{{ _("Starts after two nights of data.") }}</div>
      {% endif %}
    </div>
    <div class="panel">
      <div class="label" style="font-size:22px">{{ _("Sources") }}</div>
      {% for source in view.sources %}
      <div class="status">{{ icon("check" if source.ok else "warning", "#6fe0b5" if source.ok else "#f5b83d", 28) }}<span>{{ source.name }}</span>{% if not source.ok %}<small>{{ source.label }}</small>{% endif %}</div>
      {% endfor %}
      <div class="button">{{ _("Details") }} →</div>
    </div>
  </section>
</div>
{% endblock %}
